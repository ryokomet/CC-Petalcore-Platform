# Set these in the Vercel project settings for production.
# Browser client keys are public identifiers and must match the website clients.
PETALCORE_INDEX_API_KEY=2024-2-00682-api-key-FDRD
PETALCORE_ID_API_KEY=petalcore-id-public-client
PETALCORE_SELECT_API_KEY=petalcore-select-public-client

# Private provider credential. Never put this value in frontend JavaScript.
PLANTNET_API_KEY=

# The shared API prefix; relative URL keeps the frontend on the same deployment.
PUBLIC_API_BASE_URL=/api/v1

# Add the exact Live Server origins you use. Production site pages are same-origin.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Local development may accept any localhost port; leave unset/false on Vercel.
ALLOW_LOCAL_DEV=true
